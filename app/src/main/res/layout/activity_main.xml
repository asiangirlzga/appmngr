<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0F1B2D"
    android:orientation="vertical"
    android:paddingStart="48dp" android:paddingEnd="48dp"
    android:paddingTop="24dp" android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TV App Manager" android:textColor="#FFFFFF"
        android:textSize="28sp" android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Apps the TV needs to run are locked and cannot be removed here."
        android:textColor="#9FB3C8" android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/btn_user" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:nextFocusDown="@+id/list" />
        <Button android:id="@+id/btn_system" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:nextFocusDown="@+id/list" />
        <Button android:id="@+id/btn_protected" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:nextFocusDown="@+id/list" />
        <Button android:id="@+id/btn_all" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:nextFocusDown="@+id/list" />
    </LinearLayout>

    <TextView android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
        android:textColor="#9FB3C8" android:textSize="14sp" />

    <ListView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1F3047" android:dividerHeight="1dp"
        android:drawSelectorOnTop="true"
        android:listSelector="@drawable/row_selector"
        android:clipToPadding="false" />
</LinearLayout>
